{
  "expo": {
    "name": "Casa Libre",
    "slug": "casa-libre-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "casalibre",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "py.casalibre.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Casa Libre uses your location to show nearby properties on the map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "py.casalibre.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f9f4ee"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#f9f4ee"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "airobaseUrl": "https://d34d50f3d7174f8aadf0.db.airosofts.com",
      "airobaseAnonKey": "sb_publishable_6EWIm0Y6tFSIk8atlHbl7QJhzI1ql11o",
      "mediaBase": "https://casa-libre.com.py",
      "apiBase": "https://casa-libre.com.py",
      "pygPerUsd": 7300,
      "googleClientId": "94575907403-h2eatm61rdk8j9vsd4dfv7ofhrjq91ks.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "8e181c24-809f-4069-b315-352b3e4fefef"
      }
    },
    "owner": "57110500"
  }
}
